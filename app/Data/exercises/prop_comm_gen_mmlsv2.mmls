			"system": true
		},
		{
			"trigger": null,
			"alias": "Shift+L",
			"targetSource": null,
			"actionsUntied": ["load"],
			"actionsTied": [],
			"system": true
		},
		{
			"trigger": null,
			"alias": "Shift+S",
			"targetSource": "selected",
			"actionsUntied": ["save"],
			"actionsTied": ["save"],
			"system": true
		},
		{
			"trigger": "tap",
			"alias": null,
			"targetSource": null,
			"actionsUntied": ["toggleSelect"],
